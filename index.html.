<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adventure Quest: Lost Island</title>
<style>
  body { margin:0; overflow:hidden; font-family:Arial,sans-serif; background:#87ceeb; }
  #hud {
    position:fixed; top:12px; left:12px; color:white;
    background:#102b35cc; padding:14px; border-radius:12px;
    z-index:2; line-height:1.6;
  }
  #message {
    position:fixed; bottom:18px; left:50%; transform:translateX(-50%);
    background:#102b35dd; color:white; padding:12px 18px;
    border-radius:10px; text-align:center; z-index:2;
  }
  #error { display:none; position:fixed; inset:10px; background:#fff;
    color:#900; padding:20px; z-index:5; overflow:auto; }
</style>
</head>
<body>
<div id="hud">
  <b>🏝️ Adventure Quest: Lost Island</b><br>
  Wood: <span id="wood">0</span><br>
  Stone: <span id="stone">0</span><br>
  Berries: <span id="berries">0</span><br>
  <small>WASD / Arrow keys: Move<br>Space: Jump<br>E: Gather</small>
</div>
<div id="message">Explore the island and collect resources!</div>
<div id="error"></div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

try {
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x87ceeb);
  scene.fog = new THREE.Fog(0x87ceeb, 35, 100);

  const camera = new THREE.PerspectiveCamera(
    70, innerWidth / innerHeight, 0.1, 200
  );

  const renderer = new THREE.WebGLRenderer({antialias:true});
  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  document.body.appendChild(renderer.domElement);

  scene.add(new THREE.HemisphereLight(0xffffff, 0x557744, 2));
  const sun = new THREE.DirectionalLight(0xffffff, 2);
  sun.position.set(15,25,10);
  sun.castShadow = true;
  scene.add(sun);

  // Ocean
  const ocean = new THREE.Mesh(
    new THREE.PlaneGeometry(200,200),
    new THREE.MeshStandardMaterial({color:0x168dbb})
  );
  ocean.rotation.x = -Math.PI/2;
  ocean.position.y = -0.5;
  scene.add(ocean);

  // Island
  const island = new THREE.Mesh(
    new THREE.CylinderGeometry(17,19,3,64),
    new THREE.MeshStandardMaterial({color:0x42a64b})
  );
  island.position.y = 0.5;
  island.receiveShadow = true;
  scene.add(island);

  // Sandy beach
  const beach = new THREE.Mesh(
    new THREE.CylinderGeometry(18,19,0.5,64),
    new THREE.MeshStandardMaterial({color:0xe6cf87})
  );
  beach.position.y = -0.9;
  scene.add(beach);

  // Hills
  for(let i=0;i<9;i++){
    const a = i/9*Math.PI*2;
    const hill = new THREE.Mesh(
      new THREE.ConeGeometry(3+Math.random()*2,5+Math.random()*4,8),
      new THREE.MeshStandardMaterial({color:0x328344})
    );
    hill.position.set(Math.cos(a)*8,2,Math.sin(a)*8);
    hill.castShadow = true;
    scene.add(hill);
  }

  // Palm trees
  function makeTree(x,z){
    const trunk = new THREE.Mesh(
      new THREE.CylinderGeometry(.22,.35,3,8),
      new THREE.MeshStandardMaterial({color:0x80512c})
    );
    trunk.position.set(x,2,z);
    trunk.castShadow = true;
    scene.add(trunk);

    for(let j=0;j<6;j++){
      const leaf = new THREE.Mesh(
        new THREE.ConeGeometry(.55,3,5),
        new THREE.MeshStandardMaterial({color:0x16833b})
      );
      const angle=j*Math.PI/3;
      leaf.position.set(
        x+Math.cos(angle)*1.1,3.4,z+Math.sin(angle)*1.1
      );
      leaf.rotation.z=-Math.PI/2;
      leaf.rotation.y=-angle;
      scene.add(leaf);
    }
  }

  for(let i=0;i<18;i++){
    const a=Math.random()*Math.PI*2;
    const r=5+Math.random()*10;
    makeTree(Math.cos(a)*r,Math.sin(a)*r);
  }

  // Collectible resources
  const resources=[];
  const types=[
    {name:'wood',color:0x98552b},
    {name:'stone',color:0x888888},
    {name:'berries',color:0xe52b55}
  ];

  for(let i=0;i<18;i++){
    const type=types[i%3];
    const a=Math.random()*Math.PI*2;
    const r=3+Math.random()*11;
    const item=new THREE.Mesh(
      new THREE.DodecahedronGeometry(.45),
      new THREE.MeshStandardMaterial({color:type.color})
    );
    item.position.set(Math.cos(a)*r,.5,Math.sin(a)*r);
    item.castShadow=true;
    scene.add(item);
    resources.push({mesh:item,type:type.name});
  }

  // Player
  const player=new THREE.Group();
  const body=new THREE.Mesh(
    new THREE.CapsuleGeometry(.45,.9,4,8),
    new THREE.MeshStandardMaterial({color:0x2455dd})
  );
  body.position.y=.9;
  body.castShadow=true;
  player.add(body);
  player.position.set(0,0,0);
  scene.add(player);

  let verticalSpeed=0;
  let grounded=true;
  const keys={};
  const inventory={wood:0,stone:0,berries:0};

  addEventListener('keydown',e=>{
    keys[e.key.toLowerCase()]=true;
    if(e.code==='Space' && grounded){
      verticalSpeed=.19;
      grounded=false;
    }
    if(e.key.toLowerCase()==='e') gather();
  });
  addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);

  function gather(){
    let nearest=null, distance=2.5;
    for(const item of resources){
      if(!item.mesh.visible) continue;
      const d=player.position.distanceTo(item.mesh.position);
      if(d<distance){distance=d;nearest=item;}
    }
    if(nearest){
      inventory[nearest.type]++;
      document.getElementById(nearest.type).textContent=
        inventory[nearest.type];
      nearest.mesh.visible=false;
      document.getElementById('message').textContent=
        'Collected '+nearest.type+'!';
    } else {
      document.getElementById('message').textContent=
        'Move closer to a resource to collect it.';
    }
  }

  camera.position.set(0,7,11);
  camera.lookAt(player.position);

  function animate(){
    requestAnimationFrame(animate);

    const speed=.11;
    if(keys['w']||keys['arrowup']) player.position.z-=speed;
    if(keys['s']||keys['arrowdown']) player.position.z+=speed;
    if(keys['a']||keys['arrowleft']) player.position.x-=speed;
    if(keys['d']||keys['arrowright']) player.position.x+=speed;

    const limit=15;
    player.position.x=THREE.MathUtils.clamp(player.position.x,-limit,limit);
    player.position.z=THREE.MathUtils.clamp(player.position.z,-limit,limit);

    verticalSpeed-=.009;
    player.position.y+=verticalSpeed;
    if(player.position.y<=0){
      player.position.y=0;
      verticalSpeed=0;
      grounded=true;
    }

    const target=new THREE.Vector3(
      player.position.x,
      player.position.y+5,
      player.position.z+8
    );
    camera.position.lerp(target,.08);
    camera.lookAt(player.position.x,player.position.y+1,player.position.z);

    renderer.render(scene,camera);
  }
  animate();

  addEventListener('resize',()=>{
    camera.aspect=innerWidth/innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth,innerHeight);
  });

} catch(error) {
  const box=document.getElementById('error');
  box.style.display='block';
  box.textContent='Game error: '+error.message;
}
</script>
</body>
</html>

