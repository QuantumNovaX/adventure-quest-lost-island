<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adventure Quest: Lost Island</title>
<style>
* { box-sizing:border-box; }

body {
  margin:0;
  min-height:100vh;
  display:grid;
  place-items:center;
  font-family:Arial,sans-serif;
  color:white;
  background:
    linear-gradient(#001b2788,#001b27cc),
    url("https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?w=1600")
    center/cover;
}

.menu {
  text-align:center;
  padding:30px;
}

h1 {
  font-size:clamp(35px,7vw,70px);
  text-shadow:0 4px 15px black;
  margin-bottom:10px;
}

p {
  font-size:18px;
}

button {
  background:#178c62;
  color:white;
  padding:16px 35px;
  border:0;
  border-radius:10px;
  font-size:17px;
  cursor:pointer;
  margin-top:20px;
}

button:hover {
  background:#20b77b;
}

#status {
  margin-top:20px;
  color:#c4ffe2;
}
</style>
</head>
<body>

<div class="menu">
  <h1>🌴 LOST ISLAND</h1>
  <p>Survive Together. Find Your Way Home.</p>

  <button onclick="startGame()">
    START ADVENTURE
  </button>

  <div id="status">Adventure awaits...</div>
</div>

<script>
function startGame() {
  document.getElementById("status").textContent =
    "Your adventure is beginning...";
}
</script>

</body>
</html>
